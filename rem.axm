non mainClass() [
    number x := 5;;
    print("x is ", x);;
]
END


non mainClass() [
    number sum := 0;;
    begin for (number i := 0 ;; i < 5 ;; inc i)
        sum +:= i;;
       
    endfor
    chk (sum > 5) [
        print("Big");;
    ] otherwise [
        print("Small");;
    ]
]
END

non mainClass() [
    number x := 5
    print(x);;
]
END

non mainClass() [
    chk (x > 2 [
        print("hi");;
    ]
]
END

non mainClass() [
    chk (x > 2) [
        print("hi");;
]
))
END



non mainClass() [
    number sum := 0;;
    begin for (number i := 0 ;; i < 5 ;; inc i)
        sum +:= i;;

        choose (i) [
            case 1:
                print("hello");;
                chk (sum > 0) [
                    print("sum is positive");;
                ] otherwise [
                    print("sum is zero");;
                ]
            case 2:
                print("right");;
            default:
                print("end");;
        ]

        chk (sum > 5) [
            print("Big");;
        ] otherwise [
            print("Small");;
        ]
    endfor
]
END



USE <iostream>

number func add(number a, number b) [
    number r := a + b
    return r;;
]

number func square(number n) [
    return n * ;;
]

non func greet(word name) [
    print("Hello " + name;;
]

number func max(number a, number b) [
    chk (a > b [
        return a;;
    ] otherwise [
        return b;;
    ]
]

non func loop() [
    begin for (number i := 0 ;; i < 5 ;; inc i
        print(i);;
    endfor
]

number func ok(number x) [
    return x + 1;;
]

non mainClass() [
    number total := 0;;
    total := 5;;
    number k := add(1, 2);;
    print(total)
    print(k);;
    return;;
]




